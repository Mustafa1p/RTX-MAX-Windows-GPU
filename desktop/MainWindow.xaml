<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RTX-MAX — GPU Workbench" Width="1280" Height="840" MinWidth="1080" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#0D1724" Foreground="#EEF4FA" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
 <Window.Resources>
  <SolidColorBrush x:Key="Secondary" Color="#A8BBD0"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Secondary}"/><Setter Property="FontSize" Value="13"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
  <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="#152438"/><Setter Property="BorderBrush" Value="#2A3D52"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#21374B"/><Setter Property="Foreground" Value="#EEF4FA"/><Setter Property="Padding" Value="16,10"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#3C536B"/><Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="42"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#87CFFF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#FFFFFF"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#7CE3AC"/><Setter Property="Foreground" Value="#10251D"/><Setter Property="BorderBrush" Value="#7CE3AC"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Margin" Value="0,4"/><Setter Property="Padding" Value="18,13"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0D1724"/><Setter Property="Foreground" Value="#EEF4FA"/><Setter Property="BorderBrush" Value="#3C536B"/><Setter Property="Padding" Value="10"/><Setter Property="CaretBrush" Value="#7CE3AC"/><Setter Property="MinHeight" Value="40"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D5E2EF"/><Setter Property="Margin" Value="0,8"/></Style>
 </Window.Resources>
 <Grid Background="#0D1724">
  <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#111E2D" BorderBrush="#2A3D52" BorderThickness="0,0,1,0" Padding="20,28">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="4,0,0,40"><TextBlock Text="RTX-MAX" Foreground="#7CE3AC" FontSize="27" FontWeight="Bold"/><TextBlock Text="GPU WORKBENCH" FontSize="11" Foreground="{StaticResource Secondary}" Margin="1,5,0,0"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom"><Border Height="1" Background="#2A3D52" Margin="4,16"/><TextBlock Text="LOCAL BY DESIGN" FontSize="11" Foreground="#87CFFF" Margin="4,0,0,8"/><TextBlock Style="{StaticResource Muted}" Text="Reports stay on this PC. No recovery keys collected." Margin="4,0,4,18"/><Button x:Name="AdminButton" Content="Run as administrator" FontSize="12"/><TextBlock x:Name="VersionLabel" Text="v0.2.0 · Windows x64" Style="{StaticResource Muted}" FontSize="11" Margin="4,14,0,0"/></StackPanel>
    <StackPanel><Button x:Name="OverviewNav" Style="{StaticResource Nav}" Content="01   Overview"/><Button x:Name="BenchmarkNav" Style="{StaticResource Nav}" Content="02   Benchmark"/><Button x:Name="SetupNav" Style="{StaticResource Nav}" Content="03   Setup"/><Button x:Name="ReportsNav" Style="{StaticResource Nav}" Content="04   Reports"/></StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="30,24,30,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="Your GPU, clearly understood." FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Check the hardware. Measure the compute. Qualify before setup." Style="{StaticResource Muted}" Margin="0,7,20,0"/></StackPanel><Button Grid.Column="1" x:Name="ScanButton" Style="{StaticResource Primary}" Content="Scan this PC" VerticalAlignment="Center"/></Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
    <Grid>
     <StackPanel x:Name="OverviewPage">
      <Border Style="{StaticResource Panel}"><StackPanel><DockPanel><TextBlock Text="DETECTED HARDWARE" FontSize="11" Foreground="#87CFFF"/><TextBlock x:Name="DeviceBadge" Text="WAITING FOR SCAN" Foreground="#F5C779" FontSize="11" HorizontalAlignment="Right"/></DockPanel><TextBlock x:Name="GpuName" Text="Start with a hardware scan" FontSize="28" FontWeight="SemiBold" Margin="0,18,0,6"/><TextBlock x:Name="GpuIdentity" Text="RTX 20 / 30 / 40 / 50 owners can inspect their GPU. Unlock support is device-specific." Style="{StaticResource Muted}"/><UniformGrid Columns="4" Margin="0,26,0,0"><StackPanel><TextBlock Text="VRAM" Style="{StaticResource Muted}"/><TextBlock x:Name="VramValue" Text="—" FontSize="30" FontFamily="Consolas" Margin="0,5,0,0"/></StackPanel><StackPanel><TextBlock Text="TEMPERATURE" Style="{StaticResource Muted}"/><TextBlock x:Name="TempValue" Text="—" FontSize="30" FontFamily="Consolas" Margin="0,5,0,0"/></StackPanel><StackPanel><TextBlock Text="POWER LIMIT" Style="{StaticResource Muted}"/><TextBlock x:Name="PowerValue" Text="—" FontSize="30" FontFamily="Consolas" Margin="0,5,0,0"/></StackPanel><StackPanel><TextBlock Text="GPU USE" Style="{StaticResource Muted}"/><TextBlock x:Name="UseValue" Text="—" FontSize="30" FontFamily="Consolas" Margin="0,5,0,0"/></StackPanel></UniformGrid></StackPanel></Border>
      <Border Style="{StaticResource Panel}" BorderBrush="#786343"><StackPanel><TextBlock Text="Unlock eligibility" Style="{StaticResource Section}"/><TextBlock x:Name="EligibilityText" Text="Not evaluated" FontSize="18" Foreground="#F5C779"/><TextBlock x:Name="EligibilityDetail" Text="A matching model is a starting point. Preboot ownership, local profile and hardware results decide qualification." Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Health &amp; startup evidence" Style="{StaticResource Section}"/><StackPanel x:Name="HealthRows"><TextBlock Text="The scan reads Windows device status, NVIDIA telemetry, startup configuration and installed artifacts." Style="{StaticResource Muted}"/></StackPanel></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="BenchmarkPage" Visibility="Collapsed">
      <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Measure on your own hardware" Style="{StaticResource Section}"/><TextBlock Text="Real CUDA/cuBLAS GEMM timings with full output verification. A compute gain is not a game-FPS claim. RTX 20 skips BF16/TF32; other modes depend on the installed GPU, driver and libraries." Style="{StaticResource Muted}"/><TextBlock Text="CUDA / cuBLAS library folder" Margin="0,20,0,7"/><DockPanel><Button x:Name="LibrariesBrowse" Content="Browse" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox x:Name="LibraryPath" ToolTip="Folder containing CUDA runtime and matching cuBLAS/cuBLASLt DLLs"/></DockPanel><WrapPanel Margin="0,14,0,0"><Button x:Name="DownloadLibraries" Content="Get verified NVIDIA libraries" Margin="0,0,10,8"/><Button x:Name="CurrentButton" Content="Run current measurement" Margin="0,0,10,8"/><Button x:Name="BeforeButton" Content="Capture Before" Margin="0,0,10,8"/><Button x:Name="AfterButton" Style="{StaticResource Primary}" Content="Capture After" Margin="0,0,0,8"/></WrapPanel><TextBlock Text="Before requires a normal Windows boot with Fast Startup off, confirmed by an elevated scan. After must follow a newer boot. No GPU settings are changed by the benchmark." Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Panel}"><StackPanel><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Before / after comparison" Style="{StaticResource Section}" VerticalAlignment="Center" Margin="0"/><Button x:Name="CompareButton" Content="Compare saved files" Grid.Column="1" Margin="16,0,0,0"/></Grid><TextBlock x:Name="ComparisonNote" Text="No measurements loaded. Empty values stay empty until you run or select real result files." Style="{StaticResource Muted}" Margin="0,0,0,18"/><StackPanel x:Name="ComparisonRows"/><TextBlock x:Name="MeasurementStatus" Text="Ready. Full protocol: 4096 × 4096, 3 trials, 30 samples, 2 s warmup per mode." Style="{StaticResource Muted}" Margin="0,16,0,0"/></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="SetupPage" Visibility="Collapsed">
      <Border Style="{StaticResource Panel}" BorderBrush="#786343"><StackPanel><TextBlock Text="A guided UEFI setup, with explicit gates" Style="{StaticResource Section}"/><TextBlock x:Name="SetupGate" Text="Scan first. A candidate GPU is not yet qualified for firmware changes." Foreground="#F5C779"/><TextBlock Text="The unlock runs before Windows. This app prepares and verifies your local files; the reviewed boot procedure and hardware qualification remain required. It does not guess a profile, format a disk, suspend BitLocker or silently change boot order." Style="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="1  Establish the local evidence" Style="{StaticResource Section}"/><TextBlock Text="Capture a stock baseline. Save your recovery key privately. Obtain two matching cold probe captures and review the ownership layout. Build the matching port and generate a profile from those local captures." Style="{StaticResource Muted}"/><WrapPanel Margin="0,16,0,0"><Button x:Name="ExtractSource" Content="Extract source &amp; setup tools" Margin="0,0,12,0"/><Button x:Name="GuideButton" Content="Read full setup steps"/></WrapPanel></StackPanel></Border>
      <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="2  Prepare a verified file package" Style="{StaticResource Section}"/><TextBlock Text="Choose your locally built EFI and reviewed profile/assets. Format/hash validation prepares files; it does not certify another PC's topology." Style="{StaticResource Muted}" Margin="0,0,0,14"/>
       <TextBlock Text="Build directory (build.json + BOOTX64.EFI)" Margin="0,8,0,6"/><DockPanel><Button x:Name="BuildBrowse" Content="Browse" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox x:Name="BuildPath"/></DockPanel>
       <TextBlock Text="Local runtime profile (PROFILE.BIN)" Margin="0,14,0,6"/><DockPanel><Button x:Name="ProfileBrowse" Content="Browse" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox x:Name="ProfilePath"/></DockPanel>
       <TextBlock Text="Firmware asset directory (five assets + NVIDIA-LICENSE)" Margin="0,14,0,6"/><DockPanel><Button x:Name="AssetsBrowse" Content="Browse" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox x:Name="AssetsPath"/></DockPanel>
       <TextBlock Text="New output folder on a fixed Windows data drive" Margin="0,14,0,6"/><DockPanel><Button x:Name="DestinationBrowse" Content="Parent folder" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox x:Name="DestinationPath"/></DockPanel>
       <CheckBox x:Name="ReviewCheck"><TextBlock Text="These inputs belong to this PC, and the preboot profile/ownership evidence has been reviewed."/></CheckBox><Button x:Name="StageButton" Style="{StaticResource Primary}" Content="Validate &amp; prepare package" HorizontalAlignment="Left" Margin="0,14,0,0"/><TextBlock x:Name="StageStatus" Text="No package prepared." Style="{StaticResource Muted}" Margin="0,12,0,0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="3  Boot, verify, then qualify automation" Style="{StaticResource Section}"/><TextBlock Text="Use the documented spare FAT32 USB/manual U flow first. Return to Windows and capture After; compare only matched, correct results from different boots. Internal automatic startup needs its own reviewed partition identities and real boot-source test. Already verified installations reapply during full startup." Style="{StaticResource Muted}"/><Button x:Name="SetupResultsButton" Content="Go to after-test &amp; comparison" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="ReportsPage" Visibility="Collapsed"><Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Your evidence, kept local" Style="{StaticResource Section}"/><TextBlock Text="Health scans and compute sessions are saved under your local RTX-MAX data folder. GPU UUIDs are stored only as a one-way device key. Raw boot evidence may include partition identifiers; review reports before sharing." Style="{StaticResource Muted}"/><WrapPanel Margin="0,20,0,0"><Button x:Name="OpenReports" Content="Open local reports" Margin="0,0,12,0"/><Button x:Name="ExportHealth" Content="Export redacted health JSON" Margin="0,0,12,0"/><Button x:Name="ExportComparison" Content="Export comparison JSON"/></WrapPanel><TextBlock x:Name="ReportsLocation" Style="{StaticResource Muted}" Margin="0,20,0,0"/><TextBlock Text="Activity" FontSize="18" FontWeight="SemiBold" Margin="0,26,0,12"/><TextBox x:Name="ActivityLog" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="290" FontFamily="Consolas" FontSize="12"/></StackPanel></Border></StackPanel>
    </Grid>
   </ScrollViewer>
   <StackPanel Grid.Row="2" Margin="0,14,0,0"><ProgressBar x:Name="BusyBar" Height="3" Foreground="#7CE3AC" Background="#21374B" Visibility="Collapsed" IsIndeterminate="True"/><DockPanel Margin="0,9,0,0"><Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Stop measurement" FontSize="12" Padding="10,4" MinHeight="28" Visibility="Collapsed"/><TextBlock x:Name="FooterStatus" Text="Ready · No measurements or firmware actions run." Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/></DockPanel></StackPanel>
  </Grid>
 </Grid>
</Window>
